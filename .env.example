# ==============================================================================
# ClassPilot - Global / Docker Compose Environment Variables Template
# Copy this file to .env and customize for your deployment environment.
# DO NOT COMMIT SENSITIVE VALUES TO VERSION CONTROL.
# ==============================================================================

# Project Metadata
PROJECT_NAME="ClassPilot – Smart Academic Management System"
TAGLINE="Learning. Managing. Growing."
ENVIRONMENT=production

# Database Configuration (PostgreSQL)
# Standard local/Docker defaults:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=classpilot_db
# In Docker Compose, the backend connects to the db container:
DATABASE_URL=postgresql+psycopg2://postgres:postgrespassword@db:5432/classpilot_db

# For external cloud databases (e.g., Supabase, Neon, Render, Railway):
# DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>?sslmode=require

# JWT Authentication
# Generate a secure secret using: openssl rand -hex 32
JWT_SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration (comma-separated origins or JSON array)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost,http://localhost:80

# Frontend API Endpoint
VITE_API_BASE_URL=http://localhost:8000
