# ==============================================================================
# ClassPilot .gitignore - Production & Repository Cleanliness
# ==============================================================================

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
env/
venv/
ENV/
env.bak/
venv.bak/
.venv/
backend/venv/
.pytest_cache/
*.log
logfile.txt

# Node & Frontend
node_modules/
frontend/node_modules/
dist/
frontend/dist/
frontend/dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Database & Local Cluster Data
backend/pgdata/
pgdata/
*.sqlite
*.sqlite3
*.db
*.dump

# Media & User Uploads (preserve folder structure via .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep
!backend/uploads/*/
!backend/uploads/*/.gitkeep

# Environment variables & Secrets (CRITICAL: Never commit secrets)
.env
*.env
.env.*
backend/.env
frontend/.env
frontend/.env.local
frontend/.env.*.local

# Preserve example environment templates
!.env.example
!backend/.env.example
!frontend/.env.example

# IDE, OS & System Metadata
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo

# User-uploaded files
backend/uploads/
