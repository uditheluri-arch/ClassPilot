# ==============================================================================
# ClassPilot Backend Environment Variables Template
# Copy this file to backend/.env and replace placeholders with your actual settings.
# ==============================================================================

# Project Info
PROJECT_NAME="ClassPilot – Smart Academic Management System"
TAGLINE="Learning. Managing. Growing."
ENVIRONMENT=development

# Database Connection
# Local ClassPilot PostgreSQL:
DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5433/classpilot_db
# Cloud PostgreSQL (Neon / Supabase / Render / Railway):
# DATABASE_URL=postgresql+psycopg2://user:password@cloud-host.com:5432/dbname?sslmode=require

# JWT Authentication
# Generate a secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-secure-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (comma-separated list of allowed frontend URLs)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
